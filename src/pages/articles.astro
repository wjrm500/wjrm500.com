---
import Base from '../layouts/Base.astro';
import { getPosts, postUrl, formatDate, slugify } from '../lib';

const posts = await getPosts();
const byYear = Map.groupBy(posts, (p) => p.data.date.getUTCFullYear());
const counts = new Map<string, number>();
for (const c of posts.flatMap((p) => p.data.categories)) counts.set(c, (counts.get(c) ?? 0) + 1);
const categories = [...counts].sort(([a], [b]) => a.localeCompare(b));
---

<Base title="Articles" description="Every article on the site, newest first.">
  <header class="page-header">
    <h1>Articles</h1>
    <p class="meta">{posts.length} articles since {[...byYear.keys()].at(-1)}</p>
  </header>
  <p class="categories">
    {categories.map(([c, n]) => (
      <a class="tag" href={`/category/${slugify(c)}`}>{c} <span>{n}</span></a>
    ))}
  </p>
  {[...byYear].map(([year, list]) => (
    <section class="archive">
      <h2>{year}</h2>
      <ul>
        {list.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <a href={postUrl(p)}>{p.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
