---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, SITE_DESCRIPTION } from '../lib';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home/index.md is missing');
const { Content } = await render(home);
const posts = (await getPosts()).slice(0, 7);
---

<Base wide>
  <header class="hero">
    <h1>Will May <em>Learns How to</em> Develop Software</h1>
    <p>{SITE_DESCRIPTION}</p>
  </header>
  <article class="prose intro">
    <Content />
  </article>
  <div class="section-heading">
    <h2>Latest articles</h2>
    <a href="/articles">All articles →</a>
  </div>
  <PostList posts={posts} feature />
</Base>
