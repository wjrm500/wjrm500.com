---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home/index.md is missing');
const { Content } = await render(home);
const posts = (await getPosts()).slice(0, 6);
---

<Base>
  <article class="prose intro">
    <Content />
  </article>
  <h2 class="section-heading">Latest articles</h2>
  <PostList posts={posts} />
  <p class="more"><a href="/articles">All articles →</a></p>
</Base>
