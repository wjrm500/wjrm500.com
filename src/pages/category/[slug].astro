---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugify } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  const names = [...new Set(posts.flatMap((p) => p.data.categories))];
  return names.map((name) => ({
    params: { slug: slugify(name) },
    props: { name, posts: posts.filter((p) => p.data.categories.includes(name)) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={name} description={`Articles about ${name}.`} wide>
  <header class="page-header">
    <p class="eyebrow">Category</p>
    <h1>{name}</h1>
    <p class="meta">{posts.length} {posts.length === 1 ? 'article' : 'articles'} · <a href="/articles">All categories</a></p>
  </header>
  <PostList posts={posts} />
</Base>
